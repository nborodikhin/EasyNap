<?xml version="1.0" encoding="utf-8"?>
<!--
  Translated from the handoff "Recommended" icon (lines 273-283 of Easy Nap.dc.html):
  - Circle outline with 5dp stroke, dark fill (not a donut — the background shows through)
  - Two arched bell bumps (∩) at top-left and top-right, rotated ±30°
  - "zz" lettering centered inside the circle
  All scaled from the handoff's 74×74 content into the 72×72 adaptive icon safe zone (18-90).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.684"
        android:scaleY="0.684"
        android:translateX="17.1"
        android:translateY="17.1">
    <!--
      Left bell: ∩ arch (18×18 element, border-radius:50% 50% 0 0, border-bottom:none)
      Centerline path at radius 6.5 inside a 9dp-radius arch, strokeWidth 5.
      Rotated -30° around the bell center (35, 23).
    -->
    <group
        android:rotation="-30"
        android:pivotX="35"
        android:pivotY="23">
        <path
            android:fillColor="#00000000"
            android:strokeColor="#5AD6C5"
            android:strokeWidth="5"
            android:strokeLineCap="round"
            android:pathData="M28.5,32 L28.5,23 A6.5,6.5 0 0 1 41.5,23 L41.5,32" />
    </group>

    <!--
      Right bell: ∩ arch, rotated +30° around its center (73, 23).
    -->
    <group
        android:rotation="30"
        android:pivotX="73"
        android:pivotY="23">
        <path
            android:fillColor="#00000000"
            android:strokeColor="#5AD6C5"
            android:strokeWidth="5"
            android:strokeLineCap="round"
            android:pathData="M66.5,32 L66.5,23 A6.5,6.5 0 0 1 79.5,23 L79.5,32" />
    </group>

    <!--
      Clock body: circle outline, centered at (54, 57), radius 27dp, stroke 5dp.
      Dark fill so the background gradient shows through the inside.
    -->
    <path
        android:fillColor="#0F1513"
        android:strokeColor="#5AD6C5"
        android:strokeWidth="5"
        android:pathData="M27,57 a27,27 0 1,1 54,0 a27,27 0 1,1 -54,0 Z" />

    <!--
      "zz" — two Z strokes centered inside the clock face.
      Big Z (18sp equivalent), small z (13sp equivalent), side by side.
    -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#76F3E1"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M41,50 L54,50 L41,65 L54,65" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#76F3E1"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M57,52 L66,52 L57,62 L66,62" />

    </group>

</vector>
